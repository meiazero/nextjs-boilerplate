{
  "name": "nextjs-boilerplate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack --port 3001",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier \"**/*.{ts,tsx,json,yml,yaml,css}\" --check --cache --cache-strategy=content --cache-location=.prettiercache --write",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@elysiajs/eden": "1.4.5",
    "@t3-oss/env-nextjs": "^0.13.8",
    "better-auth": "1.4.6",
    "dotenv": "17.2.3",
    "drizzle-orm": "0.45.0",
    "elysia": "1.4.18",
    "jiti": "^2.5.1",
    "next": "^16.0.8",
    "pg": "8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@trivago/prettier-plugin-sort-imports": "6.0.0",
    "@types/bun": "1.3.4",
    "@types/node": "^20.19.13",
    "@types/pg": "8.15.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "clsx": "2.1.1",
    "drizzle-kit": "0.31.8",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.0.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.0"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "packageManager": "bun@1.3.4"
}
